# Root directory that will be scanned recursively for video files.
MEDIA_PATH=/media

# Temporary directory for in-progress conversions (must have enough free space
# for at least one full-size video file at a time).
TMP_DIR=/tmp

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# AV1 encoder: libaom-av1 (reference, accurate but slow)
#              libsvtav1   (much faster, requires a custom ffmpeg build)
AV1_ENCODER=libaom-av1

# Constant-rate-factor quality for AV1 (0-63; lower = better quality, larger file).
# 30 is a sane default balancing quality and size.
AV1_CRF=30

# Encoding speed preset.
# libaom-av1 → cpu-used (0=slowest/best, 8=fastest/worst).  Default: 6
# libsvtav1  → preset   (0=slowest/best, 13=fastest/worst). Default: 6
AV1_SPEED=6

# Target bitrate for each AAC audio stream.
AAC_BITRATE=192k
